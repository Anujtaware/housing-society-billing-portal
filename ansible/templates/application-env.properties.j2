# ===================================================================
# Housing Society Billing Portal - Environment Configuration
# Managed by Ansible - DO NOT EDIT MANUALLY
# Environment : {{ environment_name | upper }}
# Application : {{ app_name }}
# Version     : {{ version }}
# ===================================================================

# Server Configuration
server.port={{ docker_container_port }}
portal.environment={{ environment_name }}
portal.version={{ version }}

# Database Datasource Configuration
spring.datasource.url=jdbc:mysql://{{ db_host }}:{{ db_port }}/{{ db_name }}?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
spring.datasource.username={{ db_user }}
spring.datasource.password={{ db_password }}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# JPA & Hibernate Properties
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect

# Docker Deployment Parameters
deployment.docker.image={{ docker_image }}
deployment.docker.container={{ docker_container_name }}
deployment.docker.host-port={{ docker_host_port }}
deployment.docker.container-port={{ docker_container_port }}
